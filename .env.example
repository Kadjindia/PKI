# Variables du front (Vite)
# ATTENTION : toute variable préfixée VITE_ est intégrée en clair dans le code
# JavaScript envoyé au navigateur. N'y mettre QUE des valeurs publiques.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Les secrets des outils (QRadar, Cortex, BitSight, Varonis) ne vont PAS ici.
# Ils sont lus côté serveur par les Edge Functions et se configurent dans Supabase
# (Cloud : Edge Functions > Secrets ; auto-hébergé : variables du service "functions") :
#   QRADAR_BASE_URL, QRADAR_SEC_TOKEN
#   CORTEX_FQDN, CORTEX_API_KEY_ID, CORTEX_API_KEY
#   BITSIGHT_TOKEN, BITSIGHT_COMPANY_GUID
#   VARONIS_BASE_URL, VARONIS_API_KEY
